<!-- Web SDK (not Worker): the Run mode hosts the Wake/Sleep Signal endpoints
     on Kestrel via WebApplication.CreateSlimBuilder. See ADR 0007. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <UserSecretsId>dotnet-FordConnectToAbrpSync-0f6700a0-e900-4ef5-8cb3-597c8606113d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FordConnectToAbrpSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- DataProtection and Extensions.Hosting come with the Web SDK's shared framework. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
